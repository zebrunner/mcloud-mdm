--- /dev/null
+++ b/app/src/main/java/com/hmdm/launcher/mcloud/Mqtt.java
@@ -0,0 +1,56 @@
+package com.hmdm.launcher.mcloud;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import com.hmdm.launcher.helper.SettingsHelper;
+
+import org.eclipse.paho.client.mqttv3.MqttConnectOptions;
+
+/**
+ * MCloud: MQTT over TLS when the server is https: ssl://<host of the server>:<mqttPort of the setup>, the certificate
+ * checked like the API (Tls: the pin of the setup, else the system CAs and the CA of the setup, and the host name).
+ * A plain http server keeps tcp:// (a lab).
+ */
+public final class Mqtt {
+
+    private static final String PREFS = "mcloud";
+    private static final String KEY_PORT = "mqttPort";
+
+    private Mqtt() {
+    }
+
+    static void savePort(Context context, int port) {
+        prefs(context).edit().putInt(KEY_PORT, port).commit();
+    }
+
+    static int port(Context context) {
+        return prefs(context).getInt(KEY_PORT, 0);
+    }
+
+    public static boolean tls(Context context) {
+        SettingsHelper settings = SettingsHelper.getInstance(context);
+        return settings.isBaseUrlSet() && settings.getBaseUrl().startsWith("https://");
+    }
+
+    /** uri is the MQTT server: the host of the server, the port of the setup (or the default one). */
+    public static String uri(Context context, String host, int defaultPort) {
+        int port = port(context);
+        if (port <= 0) {
+            port = defaultPort;
+        }
+        return (tls(context) ? "ssl://" : "tcp://") + host + ":" + port;
+    }
+
+    public static void configure(Context context, MqttConnectOptions options) {
+        if (tls(context)) {
+            // the factory verifies the server itself: paho 1.2.0 ignores the answer of its hostname verifier
+            options.setSocketFactory(Tls.verifyingSocketFactory());
+            options.setSSLHostnameVerifier(Tls.hostnameVerifier());
+        }
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+}
