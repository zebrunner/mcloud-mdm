index 0000000..0126994
--- /dev/null
+++ b/app/src/main/java/com/hmdm/launcher/mcloud/Tls.java
@@ -0,0 +1,431 @@
+package com.hmdm.launcher.mcloud;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.util.Base64;
+import android.util.Log;
+
+import com.hmdm.launcher.Const;
+
+import java.io.IOException;
+import java.net.InetAddress;
+import java.net.Socket;
+import java.security.KeyStore;
+import java.security.MessageDigest;
+import java.security.cert.Certificate;
+import java.security.cert.CertificateException;
+import java.security.cert.X509Certificate;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+
+import javax.net.ssl.HostnameVerifier;
+import javax.net.ssl.HttpsURLConnection;
+import javax.net.ssl.SSLContext;
+import javax.net.ssl.SSLPeerUnverifiedException;
+import javax.net.ssl.SSLSession;
+import javax.net.ssl.SSLSocket;
+import javax.net.ssl.SSLSocketFactory;
+import javax.net.ssl.TrustManager;
+import javax.net.ssl.TrustManagerFactory;
+import javax.net.ssl.X509TrustManager;
+
+import okhttp3.OkHttpClient;
+
+/**
+ * MCloud: the TLS trust of every connection of the agent (the API, the files, MQTT), set by the setup.
+ *
+ * - with a pin (the SHA-256 of the public key of the certificate of the server, MCLOUD_TLS_PIN of the nodes): a
+ *   certificate with a pinned key is the server, whatever its CA, name or dates (the self-signed one of stf-proxy is
+ *   fine, like curl -k --pinnedpubkey of the nodes); the host of the server accepts no other key, even from a public CA
+ * - otherwise the system CAs and the CA of the setup (a lab), never the user CAs: an STF user can add one in Settings
+ *   (network_security_config.xml trusts the system CAs only)
+ *
+ * The state is read at every handshake: the clients built before a setup follow it. A setup also starts a new TLS
+ * context: a session of the trust before it is not resumed (a resumption checks no certificate).
+ */
+public final class Tls {
+
+    private static final String PREFS = "mcloud";
+    private static final String KEY_PINS = "pins";
+    private static final String KEY_PIN_HOST = "pinHost";
+    static final int MAX_PINS = 4;
+    private static final int HANDSHAKE_TIMEOUT_MS = 30_000;
+
+    private static volatile Set<String> pins = Collections.emptySet();
+    // the host of the server: a pin is required there
+    private static volatile String pinHost;
+    private static volatile X509TrustManager caTrust;
+    private static volatile X509TrustManager systemTrust;
+    private static volatile SSLContext sslContext;
+
+    private static final HostnameVerifier PLATFORM_VERIFIER = HttpsURLConnection.getDefaultHostnameVerifier();
+    private static final X509TrustManager TRUST = new Trust();
+    private static final HostnameVerifier VERIFIER = new Verifier();
+    private static final SSLSocketFactory FACTORY = new CurrentFactory();
+    private static final SSLSocketFactory VERIFYING_FACTORY = new VerifyingFactory();
+
+    private Tls() {
+    }
+
+    /** init loads the state of the setup and makes it the default of HttpsURLConnection; once per process. */
+    static synchronized void init(Context context) {
+        load(context);
+        HttpsURLConnection.setDefaultSSLSocketFactory(socketFactory());
+        HttpsURLConnection.setDefaultHostnameVerifier(VERIFIER);
+    }
+
+    static void load(Context context) {
+        SharedPreferences prefs = prefs(context);
+        Set<String> loaded = new LinkedHashSet<>();
+        String saved = prefs.getString(KEY_PINS, "");
+        for (String pin : saved.split(",")) {
+            if (!pin.isEmpty()) {
+                loaded.add(pin);
+            }
+        }
+        pins = Collections.unmodifiableSet(loaded);
+        pinHost = prefs.getString(KEY_PIN_HOST, null);
+        X509Certificate ca = TrustedCa.trusted(context);
+        caTrust = ca != null ? caTrustManager(ca) : null;
+        sslContext = null;
+    }
+
+    /** save keeps the TLS settings of a setup: every setup replaces them, no pin clears the pin. */
+    static void save(Context context, String host, List<String> newPins) {
+        prefs(context).edit()
+                .putString(KEY_PINS, String.join(",", newPins))
+                .putString(KEY_PIN_HOST, host)
+                .commit();
+        load(context);
+    }
+
+    /** parsePins checks the pins of the setup: comma separated base64 of the 32 bytes of a SHA-256. */
+    static List<String> parsePins(String value) {
+        List<String> result = new ArrayList<>();
+        if (value == null || value.trim().isEmpty()) {
+            return result;
+        }
+        for (String pin : value.split(",")) {
+            pin = pin.trim();
+            if (pin.startsWith("sha256//")) {
+                pin = pin.substring("sha256//".length());
+            }
+            byte[] digest;
+            try {
+                digest = Base64.decode(pin, Base64.NO_WRAP);
+            } catch (IllegalArgumentException e) {
+                digest = null;
+            }
+            if (digest == null || digest.length != 32) {
+                throw new IllegalArgumentException("pin: base64 of the SHA-256 of the public key of the server");
+            }
+            String normalized = Base64.encodeToString(digest, Base64.NO_WRAP);
+            if (!result.contains(normalized)) {
+                result.add(normalized);
+            }
+        }
+        if (result.size() > MAX_PINS) {
+            throw new IllegalArgumentException("pin: " + MAX_PINS + " pins at most");
+        }
+        return result;
+    }
+
+    public static boolean pinned() {
+        return !pins.isEmpty();
+    }
+
+    public static X509TrustManager trustManager() {
+        return TRUST;
+    }
+
+    public static HostnameVerifier hostnameVerifier() {
+        return VERIFIER;
+    }
+
+    public static SSLSocketFactory socketFactory() {
+        return FACTORY;
+    }
+
+    /**
+     * verifyingSocketFactory makes sockets that come out of the handshake with the server verified (the pin or the host
+     * name): paho 1.2.0 calls its hostname verifier but ignores the answer.
+     */
+    public static SSLSocketFactory verifyingSocketFactory() {
+        return VERIFYING_FACTORY;
+    }
+
+    private static Socket verified(Socket socket, String host) throws IOException {
+        SSLSocket ssl = (SSLSocket) socket;
+        try {
+            int timeout = ssl.getSoTimeout();
+            ssl.setSoTimeout(HANDSHAKE_TIMEOUT_MS);
+            ssl.startHandshake();
+            ssl.setSoTimeout(timeout);
+            if (host == null || !VERIFIER.verify(host, ssl.getSession())) {
+                throw new SSLPeerUnverifiedException("the TLS certificate of " + host + " is refused");
+            }
+            return ssl;
+        } catch (IOException e) {
+            try {
+                ssl.close();
+            } catch (IOException ignored) {
+                // closed anyway
+            }
+            throw e;
+        }
+    }
+
+    private static SSLContext sslContext() throws IOException {
+        SSLContext context = sslContext;
+        if (context == null) {
+            synchronized (Tls.class) {
+                if (sslContext == null) {
+                    try {
+                        SSLContext created = SSLContext.getInstance("TLS");
+                        created.init(null, new TrustManager[]{TRUST}, null);
+                        sslContext = created;
+                    } catch (Exception e) {
+                        throw new IOException("TLS is not available", e);
+                    }
+                }
+                context = sslContext;
+            }
+        }
+        return context;
+    }
+
+    /** okHttp makes an OkHttp client of the agent trust the server like the rest of the agent. */
+    public static OkHttpClient.Builder okHttp(OkHttpClient.Builder builder) {
+        return builder.sslSocketFactory(socketFactory(), TRUST).hostnameVerifier(VERIFIER);
+    }
+
+    static String pin(Certificate certificate) {
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256").digest(certificate.getPublicKey().getEncoded());
+            return Base64.encodeToString(digest, Base64.NO_WRAP);
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    private static boolean isPinned(Certificate certificate) {
+        Set<String> current = pins;
+        return !current.isEmpty() && current.contains(pin(certificate));
+    }
+
+    private static X509TrustManager systemTrust() throws CertificateException {
+        X509TrustManager trust = systemTrust;
+        if (trust == null) {
+            trust = trustManager(null);
+            systemTrust = trust;
+        }
+        return trust;
+    }
+
+    private static X509TrustManager caTrustManager(X509Certificate ca) {
+        try {
+            KeyStore store = KeyStore.getInstance(KeyStore.getDefaultType());
+            store.load(null, null);
+            store.setCertificateEntry("mcloud-ca", ca);
+            return trustManager(store);
+        } catch (Exception e) {
+            Log.w(Const.LOG_TAG, "MCloud: the CA of the setup is not usable: " + e.getMessage());
+            return null;
+        }
+    }
+
+    private static X509TrustManager trustManager(KeyStore store) throws CertificateException {
+        try {
+            TrustManagerFactory factory = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm());
+            factory.init(store);
+            for (TrustManager manager : factory.getTrustManagers()) {
+                if (manager instanceof X509TrustManager) {
+                    return (X509TrustManager) manager;
+                }
+            }
+        } catch (Exception e) {
+            throw new CertificateException("no trust manager", e);
+        }
+        throw new CertificateException("no X509 trust manager");
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static final class Trust implements X509TrustManager {
+
+        @Override
+        public void checkClientTrusted(X509Certificate[] chain, String authType) throws CertificateException {
+            throw new CertificateException("the agent authenticates no client");
+        }
+
+        @Override
+        public void checkServerTrusted(X509Certificate[] chain, String authType) throws CertificateException {
+            if (chain == null || chain.length == 0) {
+                throw new CertificateException("the server sent no certificate");
+            }
+            if (isPinned(chain[0])) {
+                return;
+            }
+            CertificateException failure;
+            try {
+                systemTrust().checkServerTrusted(chain, authType);
+                return;
+            } catch (CertificateException e) {
+                failure = e;
+            }
+            X509TrustManager ca = caTrust;
+            if (ca != null) {
+                ca.checkServerTrusted(chain, authType);
+                return;
+            }
+            throw failure;
+        }
+
+        @Override
+        public X509Certificate[] getAcceptedIssuers() {
+            List<X509Certificate> issuers = new ArrayList<>();
+            try {
+                Collections.addAll(issuers, systemTrust().getAcceptedIssuers());
+            } catch (CertificateException e) {
+                // the system CAs are not available: the CA of the setup and the pins only
+            }
+            X509TrustManager ca = caTrust;
+            if (ca != null) {
+                Collections.addAll(issuers, ca.getAcceptedIssuers());
+            }
+            return issuers.toArray(new X509Certificate[0]);
+        }
+    }
+
+    /** CurrentFactory makes the sockets of the TLS context of the current setup. */
+    private static final class CurrentFactory extends SSLSocketFactory {
+
+        private static SSLSocketFactory current() throws IOException {
+            return sslContext().getSocketFactory();
+        }
+
+        @Override
+        public String[] getDefaultCipherSuites() {
+            try {
+                return current().getDefaultCipherSuites();
+            } catch (IOException e) {
+                return new String[0];
+            }
+        }
+
+        @Override
+        public String[] getSupportedCipherSuites() {
+            try {
+                return current().getSupportedCipherSuites();
+            } catch (IOException e) {
+                return new String[0];
+            }
+        }
+
+        @Override
+        public Socket createSocket() throws IOException {
+            return current().createSocket();
+        }
+
+        @Override
+        public Socket createSocket(Socket socket, String host, int port, boolean autoClose) throws IOException {
+            return current().createSocket(socket, host, port, autoClose);
+        }
+
+        @Override
+        public Socket createSocket(String host, int port) throws IOException {
+            return current().createSocket(host, port);
+        }
+
+        @Override
+        public Socket createSocket(String host, int port, InetAddress localHost, int localPort) throws IOException {
+            return current().createSocket(host, port, localHost, localPort);
+        }
+
+        @Override
+        public Socket createSocket(InetAddress host, int port) throws IOException {
+            return current().createSocket(host, port);
+        }
+
+        @Override
+        public Socket createSocket(InetAddress address, int port, InetAddress localAddress, int localPort)
+                throws IOException {
+            return current().createSocket(address, port, localAddress, localPort);
+        }
+    }
+
+    /** VerifyingFactory makes the connected sockets of CurrentFactory, handshaken and verified. */
+    private static final class VerifyingFactory extends SSLSocketFactory {
+
+        @Override
+        public String[] getDefaultCipherSuites() {
+            return FACTORY.getDefaultCipherSuites();
+        }
+
+        @Override
+        public String[] getSupportedCipherSuites() {
+            return FACTORY.getSupportedCipherSuites();
+        }
+
+        @Override
+        public Socket createSocket() throws IOException {
+            // nothing to verify before the connection: refused rather than unverified
+            throw new IOException("unconnected sockets are not verified");
+        }
+
+        @Override
+        public Socket createSocket(Socket socket, String host, int port, boolean autoClose) throws IOException {
+            return verified(FACTORY.createSocket(socket, host, port, autoClose), host);
+        }
+
+        @Override
+        public Socket createSocket(String host, int port) throws IOException {
+            return verified(FACTORY.createSocket(host, port), host);
+        }
+
+        @Override
+        public Socket createSocket(String host, int port, InetAddress localHost, int localPort) throws IOException {
+            return verified(FACTORY.createSocket(host, port, localHost, localPort), host);
+        }
+
+        @Override
+        public Socket createSocket(InetAddress host, int port) throws IOException {
+            return verified(FACTORY.createSocket(host, port), host.getHostAddress());
+        }
+
+        @Override
+        public Socket createSocket(InetAddress address, int port, InetAddress localAddress, int localPort)
+                throws IOException {
+            return verified(FACTORY.createSocket(address, port, localAddress, localPort), address.getHostAddress());
+        }
+    }
+
+    private static final class Verifier implements HostnameVerifier {
+
+        @Override
+        public boolean verify(String host, SSLSession session) {
+            if (!pins.isEmpty()) {
+                try {
+                    Certificate[] peer = session.getPeerCertificates();
+                    if (peer.length > 0 && isPinned(peer[0])) {
+                        return true;
+                    }
+                } catch (SSLPeerUnverifiedException e) {
+                    return false;
+                }
+                String server = pinHost;
+                if (server != null && server.equalsIgnoreCase(host)) {
+                    // no RemoteLogger: it needs this very server
+                    Log.w(Const.LOG_TAG, "MCloud: the TLS key of " + host + " is not the pinned one, refused");
+                    return false;
+                }
+            }
+            return PLATFORM_VERIFIER.verify(host, session);
+        }
+    }
+}
diff --git a/app/src/main/java/com/hmdm/launcher/mcloud/TrustedCa.java b/app/src/main/java/com/hmdm/launcher/mcloud/TrustedCa.java
new file mode 100644
index 0000000..a374e18
--- /dev/null
+++ b/app/src/main/java/com/hmdm/launcher/mcloud/TrustedCa.java
@@ -0,0 +1,111 @@
+package com.hmdm.launcher.mcloud;
+
+import android.app.admin.DevicePolicyManager;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.util.Base64;
+import android.util.Log;
+
+import com.hmdm.launcher.Const;
+import com.hmdm.launcher.util.LegacyUtils;
+
+import java.io.ByteArrayInputStream;
+import java.security.cert.CertificateFactory;
+import java.security.cert.X509Certificate;
+
+/**
+ * MCloud: the CA of a server with a private certificate (a lab), trusted by the agent alone (Tls). The agents before
+ * the TLS pin installed it as a user CA of the device and trusted the user CAs: the next setup or the release removes
+ * that one (the agent trusts its saved copy until then).
+ */
+final class TrustedCa {
+
+    private static final String PREFS = "mcloud";
+    private static final String KEY = "trustedCa";
+    // the CA installed as a user CA of the device by the agents before the TLS pin
+    private static final String KEY_INSTALLED = "ca";
+
+    private TrustedCa() {
+    }
+
+    /** parse reads the CA of the setup: base64 of the DER or of the PEM. */
+    static X509Certificate parse(String base64) {
+        try {
+            byte[] cert = Base64.decode(base64, Base64.DEFAULT);
+            String text = new String(cert, java.nio.charset.StandardCharsets.US_ASCII);
+            if (text.contains("-----BEGIN CERTIFICATE-----")) {
+                String body = text.replaceAll("-----[A-Z ]+-----", "").replaceAll("\\s", "");
+                cert = Base64.decode(body, Base64.DEFAULT);
+            }
+            return (X509Certificate) CertificateFactory.getInstance("X.509")
+                    .generateCertificate(new ByteArrayInputStream(cert));
+        } catch (Exception e) {
+            throw new IllegalArgumentException("ca: base64 of the DER or of the PEM of a certificate");
+        }
+    }
+
+    /** save keeps the CA of a setup for the agent, null removes it. */
+    static void save(Context context, X509Certificate ca) {
+        SharedPreferences.Editor editor = prefs(context).edit();
+        if (ca == null) {
+            editor.remove(KEY);
+        } else {
+            try {
+                editor.putString(KEY, Base64.encodeToString(ca.getEncoded(), Base64.NO_WRAP));
+            } catch (Exception e) {
+                throw new IllegalArgumentException("ca: not encodable");
+            }
+        }
+        editor.commit();
+    }
+
+    /** trusted is the CA the agent trusts besides the system CAs, null without one. */
+    static X509Certificate trusted(Context context) {
+        String saved = prefs(context).getString(KEY, null);
+        if (saved == null) {
+            saved = prefs(context).getString(KEY_INSTALLED, null);
+        }
+        if (saved == null) {
+            return null;
+        }
+        try {
+            return (X509Certificate) CertificateFactory.getInstance("X.509")
+                    .generateCertificate(new ByteArrayInputStream(Base64.decode(saved, Base64.NO_WRAP)));
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /** installed reports a user CA of the device installed by an agent before the TLS pin. */
+    static boolean installed(Context context) {
+        String saved = prefs(context).getString(KEY_INSTALLED, null);
+        if (saved == null) {
+            return false;
+        }
+        DevicePolicyManager dpm = (DevicePolicyManager) context.getSystemService(Context.DEVICE_POLICY_SERVICE);
+        try {
+            return dpm.hasCaCertInstalled(LegacyUtils.getAdminComponentName(context), Base64.decode(saved, Base64.NO_WRAP));
+        } catch (SecurityException e) {
+            return false;
+        }
+    }
+
+    /** uninstall removes the user CA of the device installed by an agent before the TLS pin (the device owner). */
+    static void uninstall(Context context) {
+        String saved = prefs(context).getString(KEY_INSTALLED, null);
+        if (saved == null) {
+            return;
+        }
+        DevicePolicyManager dpm = (DevicePolicyManager) context.getSystemService(Context.DEVICE_POLICY_SERVICE);
+        try {
+            dpm.uninstallCaCert(LegacyUtils.getAdminComponentName(context), Base64.decode(saved, Base64.NO_WRAP));
+            prefs(context).edit().remove(KEY_INSTALLED).commit();
+        } catch (SecurityException e) {
+            Log.w(Const.LOG_TAG, "MCloud: the user CA of the device is not removed: " + e.getMessage());
+        }
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+}
diff --git a/app/src/main/java/com/hmdm/launcher/mcloud/Watchdog.java b/app/src/main/java/com/hmdm/launcher/mcloud/Watchdog.java
new file mode 100644
index 0000000..b9a3f11
--- /dev/null
+++ b/app/src/main/java/com/hmdm/launcher/mcloud/Watchdog.java
@@ -0,0 +1,47 @@
+package com.hmdm.launcher.mcloud;
+
+import android.content.Context;
+import android.os.Handler;
+import android.os.Looper;
+
+import com.hmdm.launcher.Const;
+import com.hmdm.launcher.helper.Initializer;
+import com.hmdm.launcher.helper.SettingsHelper;
+import com.hmdm.launcher.util.RemoteLogger;
+import com.hmdm.launcher.util.Utils;
+
+/**
+ * MCloud: the agent starts its services (MQTT, the configuration) at every start of its process when they are not
+ * running yet. The system launcher stays on a farm device, so only BootReceiver started them after a reboot, and
+ * BOOT_COMPLETED sometimes never reached it (seen on Android 12): the device stayed without push until somebody opened
+ * the agent. Any start of the process (a receiver, WorkManager every 15 minutes, adb) now brings them back.
+ */
+public final class Watchdog {
+
+    private static volatile boolean started;
+
+    private Watchdog() {
+    }
+
+    /** claim returns true once per process: the caller starts the services. */
+    public static synchronized boolean claim() {
+        if (started) {
+            return false;
+        }
+        started = true;
+        return true;
+    }
+
+    static void ensure(Context context) {
+        final Context app = context.getApplicationContext();
+        // after the Application and the other providers are created
+        new Handler(Looper.getMainLooper()).post(() -> {
+            if (!Utils.isDeviceOwner(app) || !SettingsHelper.getInstance(app).isBaseUrlSet()
+                    || SettingsHelper.getInstance(app).getConfig() == null || !claim()) {
+                return;
+            }
+            RemoteLogger.log(app, Const.LOG_INFO, "Watchdog: starting the services");
+            Initializer.init(app, () -> Initializer.startServicesAndLoadConfig(app));
+        });
+    }
+}
