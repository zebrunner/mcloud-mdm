+++ b/app/src/main/java/com/hmdm/launcher/mcloud/Secret.java
@@ -0,0 +1,56 @@
+package com.hmdm.launcher.mcloud;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import com.hmdm.launcher.BuildConfig;
+
+/**
+ * MCloud: the shared secret of the server (MQTT password, request signatures), set over adb by SetupProvider instead of
+ * being built into the APK: one APK for every farm.
+ */
+public final class Secret {
+
+    private static final String PREFS = "mcloud";
+    private static final String KEY = "secret";
+
+    private static volatile String value = BuildConfig.REQUEST_SIGNATURE;
+
+    private Secret() {
+    }
+
+    public static String value() {
+        return value;
+    }
+
+    public static boolean isSet(Context context) {
+        return prefs(context).getString(KEY, null) != null;
+    }
+
+    /** matches compares the token with the saved secret in constant time. */
+    static boolean matches(Context context, String token) {
+        String saved = prefs(context).getString(KEY, null);
+        if (saved == null || token == null) {
+            return false;
+        }
+        return java.security.MessageDigest.isEqual(
+                saved.getBytes(java.nio.charset.StandardCharsets.UTF_8),
+                token.getBytes(java.nio.charset.StandardCharsets.UTF_8));
+    }
+
+    static void load(Context context) {
+        String saved = prefs(context).getString(KEY, null);
+        if (saved != null && !saved.isEmpty()) {
+            value = saved;
+        }
+    }
+
+    static void save(Context context, String secret) {
+        prefs(context).edit().putString(KEY, secret).commit();
+        value = secret;
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+}
diff --git a/app/src/main/java/com/hmdm/launcher/mcloud/SetupProvider.java b/app/src/main/java/com/hmdm/launcher/mcloud/SetupProvider.java
new file mode 100644
index 0000000..b9f6eb9
--- /dev/null
+++ b/app/src/main/java/com/hmdm/launcher/mcloud/SetupProvider.java
@@ -0,0 +1,184 @@
+package com.hmdm.launcher.mcloud;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Binder;
+import android.os.Bundle;
+import android.os.ParcelFileDescriptor;
+
+import com.hmdm.launcher.Const;
+import com.hmdm.launcher.helper.SettingsHelper;
+import com.hmdm.launcher.util.RemoteLogger;
+import com.hmdm.launcher.util.Utils;
+
+import java.io.FileNotFoundException;
+import java.security.cert.X509Certificate;
+import java.util.List;
+
+/**
+ * MCloud: configures and releases the agent over adb without the screen.
+ *
+ * adb shell content call --uri content://com.hmdm.launcher.mcloud --method setup \
+ *     --arg https://mdm.example.com --extra deviceId:s:SERIAL --extra secret:s:SECRET --extra token:s:SECRET \
+ *     [--extra mqttPort:i:31443] [--extra pin:s:PIN[,PIN]] [--extra ca:s:BASE64_OF_THE_CA]
+ * (MQTT is ssl:// on the host of the server for an https server; pin: base64 of the SHA-256 of the public key of the
+ * server, see Tls; ca: the CA of a private certificate, a lab)
+ * adb shell content call --uri content://com.hmdm.launcher.mcloud --method release --extra token:s:SECRET
+ * adb shell content call --uri content://com.hmdm.launcher.mcloud --method status
+ * (the url goes in --arg: "content" refuses colons in the values of --extra)
+ *
+ * Android 9+: the same parameters as JSON on the stdin of "content write --uri content://com.hmdm.launcher.mcloud/setup"
+ * (or /release), then the call without arguments: the secret is in no command line, see Staged.
+ *
+ * Only adb shell and root may call it. Every user of adb is the shell uid (the remote debug of the farm too), so once
+ * the agent has its secret, setup and release need it as the token: nobody without the secret of the server moves
+ * the device to another server or removes the device owner. The secret is never returned.
+ */
+public class SetupProvider extends ContentProvider {
+
+    private static final int SHELL_UID = 2000;
+    private static final int ROOT_UID = 0;
+    // what this agent accepts, for the enroll scripts: the TLS pin, the staged parameters of "content write"
+    private static final String FEATURES = "pin,staged";
+
+    @Override
+    public boolean onCreate() {
+        // providers are created before the other components of the app: the secret is ready for all of them
+        Secret.load(getContext());
+        Tls.init(getContext());
+        Watchdog.ensure(getContext());
+        return true;
+    }
+
+    private void checkToken(Bundle extras) {
+        if (!Secret.isSet(getContext())) {
+            return;
+        }
+        String token = extras != null ? extras.getString("token") : null;
+        if (!Secret.matches(getContext(), token)) {
+            throw new SecurityException("the token (the secret of the server) is required");
+        }
+    }
+
+    private static void checkCaller() {
+        int uid = Binder.getCallingUid();
+        if (uid != SHELL_UID && uid != ROOT_UID) {
+            throw new SecurityException("only adb shell may configure the agent");
+        }
+    }
+
+    @Override
+    public ParcelFileDescriptor openFile(Uri uri, String mode) throws FileNotFoundException {
+        checkCaller();
+        String method = uri.getPath() != null ? uri.getPath().replaceAll("^/+|/+$", "") : "";
+        if (!"setup".equals(method) && !"release".equals(method)) {
+            throw new FileNotFoundException("content write: /setup or /release");
+        }
+        if (mode == null || !mode.startsWith("w")) {
+            throw new FileNotFoundException("content write only");
+        }
+        return Staged.open(method);
+    }
+
+    @Override
+    public Bundle call(String method, String arg, Bundle extras) {
+        checkCaller();
+        if (("setup".equals(method) || "release".equals(method)) && Staged.pending(method)) {
+            // the staged parameters are the whole call: an argument together with them is refused, they stay
+            if (arg != null || (extras != null && !extras.isEmpty())) {
+                throw new IllegalArgumentException("staged parameters: call " + method + " without arguments");
+            }
+            extras = Staged.take(method);
+            if (extras == null) {
+                throw new IllegalArgumentException("the staged parameters expired: write them again");
+            }
+            arg = extras.getString("baseUrl");
+        }
+        SettingsHelper settings = SettingsHelper.getInstance(getContext());
+        if ("setup".equals(method)) {
+            checkToken(extras);
+            String baseUrl = arg;
+            String deviceId = extras != null ? extras.getString("deviceId") : null;
+            String secret = extras != null ? extras.getString("secret") : null;
+            if (baseUrl == null || !(baseUrl.startsWith("https://") || baseUrl.startsWith("http://"))) {
+                throw new IllegalArgumentException("baseUrl (http or https) is required");
+            }
+            if (deviceId == null || deviceId.trim().isEmpty()) {
+                throw new IllegalArgumentException("deviceId is required");
+            }
+            if (secret == null || secret.length() < 16) {
+                throw new IllegalArgumentException("secret (16+ characters) is required");
+            }
+            List<String> pins = Tls.parsePins(extras.getString("pin"));
+            String ca = extras.getString("ca");
+            X509Certificate caCert = ca != null && !ca.isEmpty() ? TrustedCa.parse(ca) : null;
+            settings.setBaseUrl(baseUrl);
+            settings.setSecondaryBaseUrl(baseUrl);
+            settings.setServerProject(extras.getString("serverProject", ""));
+            settings.setDeviceId(deviceId.trim());
+            Secret.save(getContext(), secret);
+            int mqttPort = extras.getInt("mqttPort", 0);
+            if (mqttPort < 0 || mqttPort > 65535) {
+                throw new IllegalArgumentException("mqttPort: 1-65535");
+            }
+            Mqtt.savePort(getContext(), mqttPort);
+            // every setup replaces the TLS settings; the agent trusts the CA alone, no user CA of the device
+            TrustedCa.uninstall(getContext());
+            TrustedCa.save(getContext(), caCert);
+            Tls.save(getContext(), Uri.parse(baseUrl).getHost(), pins);
+            if (pins.isEmpty() && baseUrl.startsWith("https://")) {
+                RemoteLogger.log(getContext(), Const.LOG_WARN, "Setup without a TLS pin: the agent trusts the "
+                        + "system CAs" + (caCert != null ? " and the CA of the setup" : "") + " for " + baseUrl);
+            }
+        } else if ("release".equals(method)) {
+            if (!Secret.isSet(getContext())) {
+                throw new SecurityException("the agent has no secret: it was never set up");
+            }
+            checkToken(extras);
+            Release.run(getContext());
+        } else if (!"status".equals(method)) {
+            throw new IllegalArgumentException("unknown method: " + method);
+        }
+        Bundle result = new Bundle();
+        result.putBoolean("deviceOwner", Utils.isDeviceOwner(getContext()));
+        result.putBoolean("configured", settings.isBaseUrlSet() && settings.getDeviceId() != null && !settings.getDeviceId().isEmpty());
+        result.putString("baseUrl", settings.isBaseUrlSet() ? settings.getBaseUrl() : null);
+        result.putString("deviceId", settings.getDeviceId());
+        result.putBoolean("configLoaded", settings.getConfig() != null);
+        result.putBoolean("secretSet", Secret.isSet(getContext()));
+        result.putString("mqtt", settings.isBaseUrlSet() ? Mqtt.uri(getContext(), Uri.parse(settings.getBaseUrl()).getHost(),
+                com.hmdm.launcher.BuildConfig.MQTT_PORT) : null);
+        result.putBoolean("caInstalled", TrustedCa.installed(getContext()));
+        result.putBoolean("caTrusted", TrustedCa.trusted(getContext()) != null);
+        result.putBoolean("pinned", Tls.pinned());
+        result.putString("features", FEATURES);
+        return result;
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection, String[] selectionArgs, String sortOrder) {
+        return null;
+    }
+
+    @Override
+    public String getType(Uri uri) {
+        return null;
+    }
+
+    @Override
+    public Uri insert(Uri uri, ContentValues values) {
+        return null;
+    }
+
+    @Override
+    public int delete(Uri uri, String selection, String[] selectionArgs) {
+        return 0;
+    }
+
+    @Override
+    public int update(Uri uri, ContentValues values, String selection, String[] selectionArgs) {
+        return 0;
+    }
+}
diff --git a/app/src/main/java/com/hmdm/launcher/mcloud/Staged.java b/app/src/main/java/com/hmdm/launcher/mcloud/Staged.java
new file mode 100644
index 0000000..31494b2
--- /dev/null
+++ b/app/src/main/java/com/hmdm/launcher/mcloud/Staged.java
@@ -0,0 +1,168 @@
+package com.hmdm.launcher.mcloud;
+
+import android.os.Bundle;
+import android.os.ParcelFileDescriptor;
+import android.os.SystemClock;
+
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.Iterator;
+
+/**
+ * MCloud: the parameters of the next setup or release written on the stdin of "content write" (Android 9+): the
+ * secret stays out of the command line of the device, which every process of the shell uid reads in /proc.
+ *
+ * printf '%s' '{"baseUrl": ..., "secret": ..., "token": ...}' | adb shell content write --uri content://com.hmdm.launcher.mcloud/setup
+ * adb shell content call --uri content://com.hmdm.launcher.mcloud --method setup
+ *
+ * The parameters are bound to their method and taken by its next call within TTL_MS, the call has no argument then.
+ */
+final class Staged {
+
+    static final long TTL_MS = 60_000;
+    static final int MAX_BYTES = 64 * 1024;
+    // "content write" returns once its data is in the pipe: the call waits for the end of the reading
+    private static final long READ_WAIT_MS = 10_000;
+
+    private static final Object LOCK = new Object();
+    private static long generation;
+    private static String method;
+    private static boolean reading;
+    private static long stagedAt;
+    private static Bundle params;
+    private static String error;
+
+    private Staged() {
+    }
+
+    /** open returns the end of a pipe "content write" writes the parameters of the method into. */
+    static ParcelFileDescriptor open(String forMethod) throws FileNotFoundException {
+        ParcelFileDescriptor[] pipe;
+        try {
+            pipe = ParcelFileDescriptor.createPipe();
+        } catch (IOException e) {
+            throw new FileNotFoundException("no pipe: " + e.getMessage());
+        }
+        final long current;
+        synchronized (LOCK) {
+            current = ++generation;
+            method = forMethod;
+            reading = true;
+            stagedAt = SystemClock.elapsedRealtime();
+            params = null;
+            error = null;
+        }
+        final ParcelFileDescriptor source = pipe[0];
+        new Thread(() -> read(source, current), "mcloud-staged").start();
+        return pipe[1];
+    }
+
+    private static void read(ParcelFileDescriptor source, long readGeneration) {
+        Bundle parsed = null;
+        String failure = null;
+        try (InputStream in = new ParcelFileDescriptor.AutoCloseInputStream(source)) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buffer = new byte[4096];
+            int n;
+            while ((n = in.read(buffer)) > 0) {
+                out.write(buffer, 0, n);
+                if (out.size() > MAX_BYTES) {
+                    throw new IllegalArgumentException("the parameters are larger than " + MAX_BYTES + " bytes");
+                }
+            }
+            parsed = bundle(new JSONObject(new String(out.toByteArray(), StandardCharsets.UTF_8)));
+        } catch (IllegalArgumentException e) {
+            failure = e.getMessage();
+        } catch (Exception e) {
+            // never the content: it has the secret
+            failure = "the parameters are not a JSON object";
+        }
+        synchronized (LOCK) {
+            if (readGeneration != generation) {
+                return;
+            }
+            reading = false;
+            params = parsed;
+            error = failure;
+            LOCK.notifyAll();
+        }
+    }
+
+    /** bundle turns the JSON of the parameters into the extras of the call: "baseUrl" is the --arg of the call. */
+    private static Bundle bundle(JSONObject json) throws Exception {
+        Bundle result = new Bundle();
+        Iterator<String> keys = json.keys();
+        while (keys.hasNext()) {
+            String key = keys.next();
+            Object value = json.get(key);
+            if ("mqttPort".equals(key)) {
+                if (!(value instanceof Number)) {
+                    throw new IllegalArgumentException("mqttPort: a number");
+                }
+                result.putInt(key, ((Number) value).intValue());
+            } else if (value instanceof String) {
+                result.putString(key, (String) value);
+            } else if (value != JSONObject.NULL) {
+                throw new IllegalArgumentException(key + ": a string");
+            }
+        }
+        return result;
+    }
+
+    /** pending reports parameters staged for the method, being read or ready. */
+    static boolean pending(String forMethod) {
+        synchronized (LOCK) {
+            return forMethod.equals(method) && SystemClock.elapsedRealtime() - stagedAt <= TTL_MS;
+        }
+    }
+
+    /** take returns the staged parameters of the method once (null: none), or fails with the reason. */
+    static Bundle take(String forMethod) {
+        synchronized (LOCK) {
+            long deadline = SystemClock.elapsedRealtime() + READ_WAIT_MS;
+            while (reading && forMethod.equals(method)) {
+                long left = deadline - SystemClock.elapsedRealtime();
+                if (left <= 0) {
+                    break;
+                }
+                try {
+                    LOCK.wait(left);
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    break;
+                }
+            }
+            if (!forMethod.equals(method)) {
+                return null;
+            }
+            boolean expired = SystemClock.elapsedRealtime() - stagedAt > TTL_MS;
+            boolean stillReading = reading;
+            Bundle result = params;
+            String failure = error;
+            clear();
+            if (expired) {
+                return null;
+            }
+            if (stillReading) {
+                throw new IllegalStateException("the staged parameters were not written completely");
+            }
+            if (failure != null) {
+                throw new IllegalArgumentException(failure);
+            }
+            return result;
+        }
+    }
+
+    private static void clear() {
+        generation++;
+        method = null;
+        reading = false;
+        params = null;
+        error = null;
+    }
+}
diff --git a/app/src/main/java/com/hmdm/launcher/mcloud/Tls.java b/app/src/main/java/com/hmdm/launcher/mcloud/Tls.java
