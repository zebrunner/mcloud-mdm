@@ -0,0 +1,42 @@
+package com.hmdm.launcher.mcloud;
+
+import android.app.admin.DevicePolicyManager;
+import android.content.Context;
+
+import com.hmdm.launcher.Const;
+import com.hmdm.launcher.util.RemoteLogger;
+import com.hmdm.launcher.util.Utils;
+
+/**
+ * MCloud: the "mcloudRelease" push and the "release" of SetupProvider (with the token). The agent clears the device
+ * owner by itself: no factory reset. adb cannot remove it: the agent is no test-only admin.
+ */
+public final class Release {
+
+    public static final String PUSH_TYPE = "mcloudRelease";
+
+    private Release() {
+    }
+
+    public static void run(Context context) {
+        if (!Utils.isDeviceOwner(context)) {
+            RemoteLogger.log(context, Const.LOG_WARN, "Release: not the device owner");
+            return;
+        }
+        RemoteLogger.log(context, Const.LOG_INFO, "Release: clearing the device owner");
+        DevicePolicyManager dpm = (DevicePolicyManager) context.getSystemService(Context.DEVICE_POLICY_SERVICE);
+        try {
+            Utils.clearDefaultLauncher(context);
+            // Android 12 fails to remove the reset password token of a leaving device owner (it lists the users
+            // without the permission): the token goes first
+            if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.O) {
+                dpm.clearResetPasswordToken(com.hmdm.launcher.util.LegacyUtils.getAdminComponentName(context));
+            }
+            // the CA of the setup goes with the device owner
+            TrustedCa.uninstall(context);
+            dpm.clearDeviceOwnerApp(context.getPackageName());
+        } catch (Exception e) {
+            RemoteLogger.log(context, Const.LOG_ERROR, "Release failed: " + android.util.Log.getStackTraceString(e));
+        }
+    }
+}
diff --git a/app/src/main/java/com/hmdm/launcher/mcloud/Secret.java b/app/src/main/java/com/hmdm/launcher/mcloud/Secret.java
new file mode 100644
